{
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./dist",

		"target": "ES2020",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",

		"types": ["node"],
		"resolveJsonModule": true,

		"sourceMap": true,

		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist"]
}