model AssetCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets Assets[]
}

model Assets {
  id          String        @id @default(cuid())
  spaceId     String
  space       Space         @relation(fields: [spaceId], references: [id])
  categoryId  Int
  category    AssetCategory @relation(fields: [categoryId], references: [id])
  name        String
  description String
  floor       Int
  capacity    Int
  picture     String
  pictureId   Int
  status      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Facility {
  id        String @id @default(cuid())
  spaceId   String
  space     Space  @relation(fields: [spaceId], references: [id])
  name      String
  status    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}