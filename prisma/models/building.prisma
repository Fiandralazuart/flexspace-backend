model Building {
  id        String   @id @default(cuid())
  name      String
  location  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isPublished Boolean  @default(false)

  createdBy String
  updatedBy String?

  creator User  @relation("BuildingCreatedBy", fields: [createdBy], references: [id])
  updater User? @relation("BuildingUpdatedBy", fields: [updatedBy], references: [id])

  spaces Space[]
}

enum SpaceStatus {
  AVAILABLE
  IN_USE
  POTENTIAL_AVAILABLE
  NON_SCHEDULED_USE
}

enum OccupancyStatus {
  EMPTY
  OCCUPIED
}

model OccupancyLog {
  id String @id @default(cuid())
  spaceId String
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  personCount Int
  occupancyStatus OccupancyStatus
  detectedAt DateTime @default(now())

  @@index([spaceId])
  @@index([detectedAt])

  @@map("occupancy_logs")
}

model Space {
  id            String      @id @default(cuid())
  buildingId    String
  building      Building    @relation(fields: [buildingId], references: [id])

  name          String
  description   String
  floor         Int?
  capacity      Int
  code          String?     @unique
  picture       String
  pictureId     String
  status        SpaceStatus @default(AVAILABLE)
  isPublished   Boolean     @default(false)

  // Realtime Occupancy
  personCount      Int               @default(0)
  occupancyStatus  OccupancyStatus   @default(EMPTY)
  lastDetectedAt   DateTime?

  assets        Assets[]
  occupancyLogs OccupancyLog[]
  devices Device?

  createdBy String
  updatedBy String?

  creator User  @relation("SpaceCreatedBy", fields: [createdBy], references: [id])
  updater User? @relation("SpaceUpdatedBy", fields: [updatedBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("spaces")
}
